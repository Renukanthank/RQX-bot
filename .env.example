# Required: get a key from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Only required if ANTHROPIC_API_KEY is an identity-linked personal key
# (Console > Settings > API Keys). Find it in Console > Settings > Workspaces,
# or in the URL when a workspace is selected. Leave unset for a plain
# workspace-scoped API key.
ANTHROPIC_WORKSPACE_ID=

# Server
PORT=3000
# Comma-separated list of origins allowed to embed the widget.
# Use * only for local testing.
ALLOWED_ORIGINS=*

# Model mapping for each RQX tier.
# Swift = fast/cheap, Prime = deep reasoning, Forge = code & engineering.
RQX_SWIFT_MODEL=claude-haiku-4-5-20251001
RQX_PRIME_MODEL=claude-sonnet-5
RQX_FORGE_MODEL=claude-sonnet-5
